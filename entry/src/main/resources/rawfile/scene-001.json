          "startTime": 22.0,
          "endTime": 25.5,
          "slowStartTime": 28.6,
          "slowEndTime": 33.2
        },
        {
          "id": "s-001-2-2",
          "speaker": "B",
          "speakerRoleJa": "店員",
          "speakerRoleZh": "店员",
          "japanese": "コンビニですか？この道を渡って、左に行くとありますよ。",
          "romaji": "konbini desu ka? kono michi o watatte, hidari ni iku to arimasu yo.",
          "translation": "便利店吗？过了这条马路往左走就有哦。",
          "segments": [
            {"text": "コンビニですか？この"},
            {"text": "道", "kana": "みち"},
            {"text": "を"},
            {"text": "渡", "kana": "わた"},
            {"text": "って、"},
            {"text": "左", "kana": "ひだり"},
            {"text": "に"},
            {"text": "行", "kana": "い"},
            {"text": "くとありますよ。"}
