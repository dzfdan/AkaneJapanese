{
  "id": "scene-001",
  "titleJa": "道を尋ねる",
  "titleZh": "问路",
  "level": "N4",
  "category": "日常生活",
  "descriptionZh": "在日本街头向路人询问路线的实用场景。包含问路、指路、换乘等常见表达。",
  "audioNormal": "scene-001-normal.wav",
  "audioSlow": "scene-001-slow.wav",
  "dialogues": [
    {
      "id": "dlg-001-1",
      "titleJa": "駅までの道を聞く",
      "titleZh": "询问去车站的路",
      "sentences": [
        {
          "id": "s-001-1-1",
          "speaker": "A",
          "speakerRoleJa": "観光客",
          "speakerRoleZh": "游客",
          "japanese": "すみません、この近くに駅がありますか？",
          "romaji": "sumimasen, kono chikaku ni eki ga arimasu ka?",
          "translation": "请问，这附近有车站吗？",
          "segments": [
            {"text": "すみません、この"},
            {"text": "近", "kana": "ちか"},
            {"text": "くに"},
            {"text": "駅", "kana": "えき"},
            {"text": "がありますか？"}
          ],
          "startTime": 0.0,
          "endTime": 3.5,
          "slowStartTime": 0.0,
          "slowEndTime": 4.6
        },
        {
          "id": "s-001-1-2",
          "speaker": "B",
          "speakerRoleJa": "通行人",
          "speakerRoleZh": "路人",
          "japanese": "ええ、ありますよ。この道をまっすぐ行ってください。",
          "romaji": "ee, arimasu yo. kono michi o massugu itte kudasai.",
          "translation": "嗯，有的哦。请沿着这条路直走。",
          "segments": [
            {"text": "ええ、ありますよ。この"},
            {"text": "道", "kana": "みち"},
            {"text": "をまっすぐ"},
            {"text": "行", "kana": "い"},
            {"text": "ってください。"}
          ],
          "startTime": 4.0,
          "endTime": 8.0,
          "slowStartTime": 5.2,
          "slowEndTime": 10.4
        },
        {
          "id": "s-001-1-3",
          "speaker": "B",
          "speakerRoleJa": "通行人",
          "speakerRoleZh": "路人",
          "japanese": "二つ目の信号を右に曲がると、左側にあります。",
          "romaji": "futatsume no shingou o migi ni magaru to, hidarigawa ni arimasu.",
          "translation": "在第二个红绿灯右转，车站就在左侧。",
          "segments": [
            {"text": "二", "kana": "ふた"},
            {"text": "つ"},
            {"text": "目", "kana": "め"},
            {"text": "の"},
            {"text": "信号", "kana": "しんごう"},
            {"text": "を"},
            {"text": "右", "kana": "みぎ"},
            {"text": "に"},
            {"text": "曲", "kana": "まが"},
            {"text": "ると、"},
            {"text": "左側", "kana": "ひだりがわ"},
            {"text": "にあります。"}
          ],
          "startTime": 8.5,
          "endTime": 13.0,
          "slowStartTime": 11.1,
          "slowEndTime": 16.9
        },
        {
          "id": "s-001-1-4",
          "speaker": "A",
          "speakerRoleJa": "観光客",
          "speakerRoleZh": "游客",
          "japanese": "わかりました。ここからどのくらいかかりますか？",
          "romaji": "wakarimashita. koko kara dono kurai kakarimasu ka?",
          "translation": "明白了。从这里大概需要多长时间？",
          "segments": [
            {"text": "わかりました。ここからどのくらいかかりますか？"}
          ],
          "startTime": 13.5,
          "endTime": 17.5,
          "slowStartTime": 17.6,
          "slowEndTime": 22.8
        },
        {
          "id": "s-001-1-5",
          "speaker": "B",
          "speakerRoleJa": "通行人",
          "speakerRoleZh": "路人",
          "japanese": "歩いて五分ぐらいです。",
          "romaji": "aruite gofun gurai desu.",
          "translation": "走路大约五分钟。",
          "segments": [
            {"text": "歩", "kana": "ある"},
            {"text": "いて"},
            {"text": "五", "kana": "ご"},
            {"text": "分", "kana": "ふん"},
            {"text": "ぐらいです。"}
          ],
          "startTime": 18.0,
          "endTime": 20.5,
          "slowStartTime": 23.4,
          "slowEndTime": 26.7
        }
      ],
      "quiz": [
        {
          "id": "q-001-1-1",
          "type": "listening",
          "questionZh": "路人告诉游客车站在哪个方向？",
          "options": ["直走后第一个红绿灯左转", "直走后第二个红绿灯右转", "直走后第二个红绿灯左转", "右转后直走"],
          "correctIndex": 1,
          "explanationZh": "路人说「二つ目の信号を右に曲がると、左側にあります」，意思是在第二个红绿灯右转后，车站在左侧。"
        },
        {
          "id": "q-001-1-2",
          "type": "meaning",
          "questionZh": "「どのくらい」在对话中的意思是？",
          "options": ["多少钱", "多长时间/多少", "在哪里", "怎么样"],
          "correctIndex": 1,
          "explanationZh": "「どのくらい」可以询问时间、距离、数量等，此处询问路程需要多长时间。"
        }
      ]
    },
    {
      "id": "dlg-001-2",
      "titleJa": "近くのコンビニ",
      "titleZh": "附近的便利店",
      "sentences": [
        {
          "id": "s-001-2-1",
          "speaker": "A",
          "speakerRoleJa": "学生",
          "speakerRoleZh": "学生",
          "japanese": "あのう、この辺にコンビニはありますか？",
          "romaji": "anou, kono hen ni konbini wa arimasu ka?",
          "translation": "请问，这附近有便利店吗？",
          "segments": [
            {"text": "あのう、この"},
            {"text": "辺", "kana": "へん"},
            {"text": "にコンビニはありますか？"}
