          "id": "s-001-2-5",
          "speaker": "A",
          "speakerRoleJa": "学生",
          "speakerRoleZh": "学生",
          "japanese": "はい、見えます。ありがとうございます！",
          "romaji": "hai, miemasu. arigatou gozaimasu!",
          "translation": "好的，看到了。非常感谢！",
          "segments": [
            {"text": "はい、"},
            {"text": "見", "kana": "み"},
            {"text": "えます。ありがとうございます！"}
          ],
          "startTime": 40.5,
          "endTime": 43.5,
          "slowStartTime": 52.7,
          "slowEndTime": 56.6
        }
      ],
      "quiz": [
        {
          "id": "q-001-2-1",
          "type": "reading",
          "questionZh": "「この道を渡って」中的「渡る」是什么意思？",
          "options": ["沿着走", "穿过、渡过", "拐弯", "返回"],
          "correctIndex": 1,
          "explanationZh": "「渡る（わたる）」表示穿过、渡过，「道を渡る」意为过马路。"
        },
        {
          "id": "q-001-2-2",
          "type": "listening",
          "questionZh": "便利店在什么位置？",
          "options": ["过马路后往左走", "过马路后往右走", "直走第二个路口左转", "红绿灯对面"],
          "correctIndex": 0,
          "explanationZh": "店员说「この道を渡って、左に行くとあります」，意思是过了马路往左走就有。"
        }
      ]
    },
