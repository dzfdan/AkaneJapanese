          "speaker": "B",
          "speakerRoleJa": "店員",
          "speakerRoleZh": "店员",
          "japanese": "あそこにありますよ。見えますか？青い信号のところです。",
          "romaji": "asoko ni arimasu yo. miemasu ka? aoi shingou no tokoro desu.",
          "translation": "就在那里哦。能看到吗？蓝色信号灯的地方。",
          "segments": [
            {"text": "あそこにありますよ。"},
            {"text": "見", "kana": "み"},
            {"text": "えますか？"},
            {"text": "青", "kana": "あお"},
            {"text": "い"},
            {"text": "信号", "kana": "しんごう"},
            {"text": "のところです。"}
          ],
          "startTime": 35.0,
          "endTime": 40.0,
          "slowStartTime": 45.5,
          "slowEndTime": 52.0
